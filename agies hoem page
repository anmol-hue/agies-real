<script>
gsap.registerPlugin(ScrollTrigger);

/* PRELOADER */
(function(){
  const pct=document.getElementById('loadpct'),bar=document.querySelector('#loadbar i');
  let p=0;const iv=setInterval(()=>{
    p=Math.min(100,p+Math.random()*14+4);
    bar.style.width=p+'%';
    pct.textContent='INITIALIZING CLINICAL REEL — '+Math.floor(p)+'%';
    if(p>=100){clearInterval(iv);
      gsap.timeline()
        .to('#loader > *',{opacity:0,y:-20,duration:.5,stagger:.06,ease:'power2.in'})
        .to('#loader',{opacity:0,duration:.6,ease:'power2.inOut',onComplete:()=>document.getElementById('loader').remove()})
        .add(filmStart,'-=.2');}
  },110);
})();

function filmStart(){
  gsap.to('#barT',{height:0,duration:1.6,ease:'power4.inOut'});
  gsap.to('#barB',{height:0,duration:1.6,ease:'power4.inOut'});
  gsap.to('#hud',{opacity:1,duration:1,delay:.9});
  gsap.to('.hero-line span',{y:0,duration:1.2,stagger:.13,ease:'power4.out',delay:.3});
  gsap.to('.hero-fade',{opacity:1,duration:1.2,stagger:.15,delay:1,ease:'power2.out'});
}

/* TIMECODE HUD */
(function(){
  const el=document.getElementById('tc');const t0=performance.now();
  setInterval(()=>{
    const ms=performance.now()-t0;
    const f=Math.floor(ms/1000*24)%24, s=Math.floor(ms/1000)%60,
          m=Math.floor(ms/60000)%60, h=Math.floor(ms/3600000);
    el.textContent=[h,m,s,f].map(n=>String(n).padStart(2,'0')).join(':');
  },41);
})();

/* PROGRESS + SCENE LABEL */
gsap.to('#prog',{width:'100%',ease:'none',
  scrollTrigger:{trigger:document.body,start:'top top',end:'bottom bottom',scrub:.3}});
document.querySelectorAll('.scene').forEach(sc=>{
  ScrollTrigger.create({trigger:sc,start:'top 55%',end:'bottom 55%',
    onEnter:()=>setScene(sc.dataset.scene),onEnterBack:()=>setScene(sc.dataset.scene)});
});
function setScene(s){gsap.fromTo('#hudScene',{opacity:0,y:8},{opacity:1,y:0,duration:.5});
  document.getElementById('hudScene').textContent=s;}

/* PARALLAX + REVEALS */
document.querySelectorAll('[data-parallax]').forEach(bg=>{
  gsap.fromTo(bg,{yPercent:-8},{yPercent:8,ease:'none',
    scrollTrigger:{trigger:bg.parentElement,start:'top bottom',end:'bottom top',scrub:true}});
});
document.querySelectorAll('.reveal').forEach(el=>{
  gsap.to(el,{opacity:1,y:0,duration:1.1,ease:'power3.out',
    scrollTrigger:{trigger:el,start:'top 88%'}});
});

/* MEGA MARQUEES */
gsap.to('#mega1',{xPercent:-25,ease:'none',scrollTrigger:{trigger:'#mega1',start:'top bottom',end:'bottom top',scrub:1}});
gsap.fromTo('#mega2',{xPercent:-30},{xPercent:0,ease:'none',scrollTrigger:{trigger:'#mega2',start:'top bottom',end:'bottom top',scrub:1}});

/* HERO SCROLL ZOOM */
gsap.to('.hero-img',{opacity:.35,scale:1.08,ease:'none',
  scrollTrigger:{trigger:'#hero',start:'top top',end:'bottom top',scrub:true}});

/* VITALS SIM */
function jit(id,base,amp){const el=document.getElementById(id);
  setInterval(()=>{el.textContent=base+Math.round((Math.random()-.5)*amp);},1500);}
jit('hrv',72,8);jit('spo2',98,2);jit('rr',14,3);
setInterval(()=>{document.getElementById('bp').textContent=
  (118+Math.round((Math.random()-.5)*8))+'/'+(76+Math.round((Math.random()-.5)*6));},2100);

/* TICKER */
const items=['<b>WARD 4A</b> · 8 OCCUPIED · 1 ALERT','<b>LAB</b> · CRP PANEL IN REVIEW','<b>INTERACTION STUDIO</b> · 3 REGIMENS SCREENED',
 '<b>eMAR</b> · NEXT ROUNDS 00:00','<b>SYSTEM</b> · ALL SERVICES NOMINAL','<b>TRIAGE</b> · 2 OBS · 1 URGENT',
 '<b>FORMULARY</b> · 3D MODELS RENDERED','<b>AUDIT</b> · 14 EVENTS LOGGED TODAY'];
const half=items.map(t=>'<span class="tk">'+t+'</span><span class="tk sep">///</span>').join('');
document.getElementById('ticker').innerHTML=half+half;
</script>
